    "test:mpc": "node scripts/test-mpc-retention.mjs"
  },
  "dependencies": {
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^5.1.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "newman": "^6.2.3",
    "oxlint": "^1.90.0",
    "playwright": "^1.65.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
