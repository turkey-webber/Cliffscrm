{
  "name": "cliffscrm",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:api": "newman run postman/collections/cliffscrm-apis.postman_collection.json -e postman/environments/local.postman_environment.json --color off",
